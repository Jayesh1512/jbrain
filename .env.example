# Copy to .env (or run ./setup.sh). Never commit .env.
JBRAIN_TOKEN=change-me-to-a-long-random-string
JBRAIN_PORT=7331
# Optional: push every change to this Git repo (https URL, owner/repo is expanded by setup.sh).
JBRAIN_GIT_REMOTE=
# Optional: access token for an https remote (GitHub: fine-grained token with Contents read/write).
JBRAIN_GIT_TOKEN=
